odroidgoa-uboot-config

setenv bootargs "root=/dev/mmcblk0p8 rootwait rw fsck.repair=yes console=tty0 fbcon=rotate:0 console=ttyS2,115200n8 coherent_pool=1m"

setenv kernel_addr_r "0x02000000"
setenv initrd_addr_r "0x04000000"
setenv fdt_addr_r    "0x01f00000"

lcdputs "[BOOT] Step 1: Loading Kernel..."
load mmc 1:1 ${kernel_addr_r} Image-arkos

lcdputs "[BOOT] Step 2: Loading Initrd..."
load mmc 1:1 ${initrd_addr_r} uInitrd-arkos

lcdputs "[BOOT] Step 3: Loading DTB..."
load mmc 1:1 ${fdt_addr_r} rk3326-r36s-android.dtb

lcdputs "[BOOT] Step 4: Booting dArkOS (Console Output ON)..."
booti ${kernel_addr_r} ${initrd_addr_r} ${fdt_addr_r}
